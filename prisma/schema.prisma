// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// العملات المدعومة
model Currency {
  id          String   @id @default(cuid())
  code        String   @unique // USD, EUR, SYP, etc.
  name        String   // اسم العملة بالعربية
  symbol      String   // $, €, etc.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // العلاقات
  vaults           Vault[]
  transactions     Transaction[]
  baseTransactions Transaction[] @relation("BaseCurrency")
  debts            Debt[]
}

// صناديق العملات (الأرصدة)
model Vault {
  id                String    @id @default(cuid())
  currencyId        String
  balance           Float     @default(0)
  openingBalance    Float     @default(0) // رصيد أول المدة
  openingBalanceDate DateTime? // تاريخ رصيد أول المدة
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // العلاقات
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  
  @@unique([currencyId])
}

// الحسابات
model Account {
  id          String   @id @default(cuid())
  name        String
  type        AccountType @default(PRIVATE)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // العلاقات
  transactions Transaction[]
  debts       Debt[]
}

enum AccountType {
  PRIVATE
  PUBLIC
}

// الحركات المالية
model Transaction {
  id              String   @id @default(cuid())
  accountId       String
  currencyId      String   // العملة النهائية (التي يسجل بها الرصيد)
  baseCurrencyId  String?  // عملة المبلغ الأساسي (اختياري - للتحويل بين العملات)
  type            TransactionType
  paymentType     PaymentType @default(CASH) // نوع الدفع: كاش أو آجل
  amount          Float    // المبلغ الأساسي
  conversionFactor Float   @default(1) // معامل التحويل
  conversionMethod ConversionMethod @default(MULTIPLY)
  feesType        FeesType @default(FIXED)
  feesAmount      Float    @default(0) // الأجور
  feesDirection   FeesDirection @default(INCOME) // اتجاه الأجور: لنا / علينا
  finalBalance    Float    // الرصيد النهائي
  isComplete      Boolean  @default(true) // حالة الاكتمال: true = مكتملة, false = غير مكتملة
  description     String?  // البيان
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // العلاقات
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency        Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
  baseCurrency    Currency? @relation(fields: [baseCurrencyId], references: [id], onDelete: SetNull, name: "BaseCurrency")
}

enum PaymentType {
  CASH      // كاش
  DEFERRED  // آجل
}

enum TransactionType {
  INCOME    // لنا
  EXPENSE   // علينا
}

enum ConversionMethod {
  MULTIPLY  // ضرب
  DIVIDE    // قسمة
}

enum FeesType {
  FIXED     // مبلغ ثابت
  PERCENTAGE // نسبة مئوية
  PER_THOUSAND // من ألف
}

enum FeesDirection {
  INCOME    // لنا
  EXPENSE   // علينا
}



// الديون
model Debt {
  id              String   @id @default(cuid())
  accountId       String
  currencyId      String
  amount          Float
  conversionFactor Float   @default(1)
  conversionMethod ConversionMethod @default(MULTIPLY)
  finalBalance    Float
  description     String?
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // العلاقات
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency        Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)
}

// إعدادات التطبيق
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// قسم المشتريات والمبيعات (Purchases & Sales)
// ============================================

// وحدات القياس (قائمة رئيسية تُدار من الإعدادات)
model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialUnits MaterialUnit[]
  purchases     Purchase[]
  sales         Sale[]

  // 🔸 Back-relation for Material.defaultUnit (required by Prisma)
  materialsAsDefault Material[]
}

// المواد
model Material {
  id            String   @id @default(cuid())
  name          String   @unique
  defaultUnitId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  defaultUnit   Unit           @relation(fields: [defaultUnitId], references: [id])
  materialUnits MaterialUnit[]
  purchases     Purchase[]
  sales         Sale[]
}

// ربط المواد بالوحدات + معامل التحويل (relative to base, internally)
model MaterialUnit {
  id           String   @id @default(cuid())
  materialId   String
  unitId       String
  baseFactor   Float    @default(1) // معامل التحويل للوحدة الأساسية (used internally)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([materialId, unitId])
}

// المشتريات — تُخصم من صندوق الدولار عند الحفظ
// purchaseType:
//   - 'purchase' (default): فاتورة شراء فعلية — تخصم من الصندوق وتُحسب ضمن مصروفات الشراء
//   - 'opening_inventory': رصيد افتتاحي للمخزون — يضيف كمية فقط، لا يخصم الصندوق ولا يُحسب كمصروف
model Purchase {
  id                  String   @id @default(cuid())
  date                DateTime @default(now())
  materialId          String
  materialName        String   // snapshot
  quantity            Float
  unitId              String
  unitName            String   // snapshot
  baseFactorSnapshot  Float    @default(1) // snapshot of base_factor at time of recording
  quantityInBase      Float    // snapshot = quantity × baseFactorSnapshot
  unitPriceUsd        Float
  totalPriceUsd       Float    // = quantity × unitPriceUsd
  // نوع العملية: 'purchase' (افتراضي) أو 'opening_inventory' (رصيد افتتاحي للمخزون)
  // الافتراضي 'purchase' للحفاظ على التوافق مع السجلات الموجودة
  purchaseType        String   @default("purchase")
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  material            Material @relation(fields: [materialId], references: [id])
  unit                Unit     @relation(fields: [unitId], references: [id])
}

// المبيعات — تُربط بحساب وتظهر في كشف الحساب، كلها بالدولار
model Sale {
  id                  String   @id @default(cuid())
  date                DateTime @default(now())
  accountId           String
  accountName         String   // snapshot
  materialId          String
  materialName        String   // snapshot
  quantity            Float
  unitId              String
  unitName            String   // snapshot
  baseFactorSnapshot  Float    @default(1)
  quantityInBase      Float    // snapshot
  unitPrice           Float    // USD
  totalPrice          Float    // USD = quantity × unitPrice
  // طريقة السداد — 'cash' (default): تُضاف قيمة الفاتورة لصندوق الدولار فوراً
  //                  'credit': بيع آجل، لا يؤثر على أي صندوق حتى تحصيله لاحقاً
  //                  (تظهر كفاتورة غير مسددة في كشف الحساب، دون أي تكامل مع نظام الديون)
  paymentMethod       String   @default("cash")
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  material            Material @relation(fields: [materialId], references: [id])
  unit                Unit     @relation(fields: [unitId], references: [id])
}
